# Copy to .env and adjust before `docker compose up`.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
NIDHI_SECRET_KEY=replace-with-a-long-random-string
POSTGRES_PASSWORD=nidhi
NIDHI_PORT=8080
# Demo mode lists demo accounts on the sign-in page and loads the synthetic dataset on first start.
NIDHI_DEMO_MODE=true
NIDHI_SEED_DEMO=true
NIDHI_CORS_ORIGINS=http://localhost:8080
# Letters carry a QR code that opens this address + /verify/<code>
NIDHI_PUBLIC_BASE_URL=http://localhost:8080
# Key for encrypting stored files at rest (base64 of 32 random bytes). Keep it with the secret key; losing it makes
# stored FDR copies and letters unreadable. Generate: python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
NIDHI_FILE_KEY=
